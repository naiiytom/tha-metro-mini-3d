{
  "name": "tha-metro-mini-3d",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node tools/fetch-network.mjs",
    "data:preprocess": "cargo run --manifest-path rust-engine/Cargo.toml -p preprocessor --release -- --track src/data/network.json --out public/data/network.tmb --report public/data/network.report.json",
    "wasm:build": "wasm-pack build rust-engine/wasm --release --target web --out-dir ../../src/sim/pkg",
    "rust:test": "cargo test --manifest-path rust-engine/Cargo.toml",
    "verify:camera": "node tools/verify-camera.mjs",
    "verify:mvp4": "node tools/verify-mvp4.mjs",
    "verify:kinematics": "node tools/verify-kinematics.mjs",
    "verify:closeup": "node tools/verify-closeup.mjs",
    "verify:perf": "node tools/verify-perf.mjs",
    "verify:mvp5": "node tools/verify-mvp5.mjs",
    "verify:mvp6": "node tools/verify-mvp6.mjs",
    "verify:mobile": "node tools/verify-mobile.mjs",
    "screenshot": "node tools/screenshot.mjs",
    "check:bundle": "node tools/check-bundle.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
